# Copy this file to .env.local for local dev. Fill in real values.
# In production, set these in the Vercel dashboard.

AI_PROVIDER=gemini

# Gemini (default)
GOOGLE_API_KEY=

# Claude (optional, only if AI_PROVIDER=claude)
ANTHROPIC_API_KEY=

# Cloudflare Turnstile
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Upstash Redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Caps
DAILY_SPEND_CAP_USD=1
RATE_LIMIT_PER_DAY=150

SENTRY_DSN=

# Consulting contact form
# Discord webhook the form POSTs submissions to. Required.
DISCORD_WEBHOOK_URL=
# Set to "false" to disable the form (returns 503). Anything else (or unset) = enabled.
CONTACT_FORM_ENABLED=
# Contact form rate limits (Vercel handles the global 150/day at the edge)
CONTACT_IP_PER_HOUR=3
CONTACT_IP_PER_DAY=5
CONTACT_EMAIL_PER_DAY=3
